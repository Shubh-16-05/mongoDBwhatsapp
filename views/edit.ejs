<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your message</title>
    <link rel="stylesheet" href="style.css">    
</head>
<body>
    <h3>Edit Your chat:<%=chat._id%></h3>
    <p>This chat is from: <b><i><%= chat.from%> </i> </b>to <b><i><%=chat.to%> </i></b></p>
    <form method="post" action="/chats/<%=chat._id%>?_method=PUT" >
    <textarea  name="msg" cols="50" rows="10"><%=chat.msg%></textarea>
    <br> 
    <button>edit</button>
    </form>
</body>
</html>